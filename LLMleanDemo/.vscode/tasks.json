{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LLMLean: Build demo",
      "type": "process",
      "command": "lake",
      "args": ["build"],
      "options": {"cwd": "${workspaceFolder}"},
      "group": {"kind": "build", "isDefault": true},
      "problemMatcher": []
    },
    {
      "label": "LLMLean: Check model setup",
      "type": "process",
      "command": "lake",
      "args": ["exe", "llmlean", "doctor"],
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
